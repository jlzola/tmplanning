<section>
  <p><a href="/">← Toutes les sessions</a></p>
  <h1>Nouvelle session TM Planning</h1>

  {{#if error}}
  <p class="error">{{error}}</p>
  {{/if}}

  <label class="file-import">
    Charger une session depuis un fichier JSON (pré-remplit le formulaire)
    <input type="file" id="json-import" accept=".json,application/json">
  </label>

  <form method="POST" action="/sessions" class="session-form">
    <label>
      Nom de la session
      <input type="text" name="name" required value="{{values.name}}" placeholder="ex. TM47CDXC">
    </label>

    <div class="date-row">
      <label>
        Indicatif du créateur
        <input type="text" name="creatorCall" required value="{{values.creator.call}}" placeholder="ex. F4IXH">
      </label>
      <label>
        Prénom du créateur
        <input type="text" name="creatorFirstName" required value="{{values.creator.firstName}}" placeholder="ex. Jelo">
      </label>
    </div>

    <div class="date-row">
      <label>
        Date de début
        <input type="date" name="startDate" required value="{{values.startDate}}">
      </label>
      <label>
        Date de fin
        <input type="date" name="endDate" required value="{{values.endDate}}">
      </label>
    </div>

    <label>
      Mot de passe de gestion (optionnel)
      {{#> password-field}}
      <input type="password" name="password" minlength="8" pattern="[A-Za-z0-9]{8,}"
        autocomplete="new-password"
        title="8 caractères minimum, lettres et chiffres uniquement (pas de caractères spéciaux)"
        placeholder="Laisser vide pour ne pas protéger la session">
      {{/password-field}}
    </label>
    <p class="field-hint">
      Si renseigné, ce mot de passe sera demandé pour accéder à la gestion de la session (⚙ Gérer).
      8 caractères minimum, lettres et chiffres uniquement, pas de caractères spéciaux.
    </p>

    <h2>Opérateurs</h2>
    <label class="file-import">
      Importer des opérateurs (CSV : call,locator,department)
      <input type="file" id="csv-import" accept=".csv,text/csv">
    </label>

    {{> operator-rows}}
    <button type="button" id="add-operator" class="btn-secondary">+ Ajouter un opérateur</button>

    <div class="form-actions">
      <button type="submit" class="btn">Créer la session</button>
    </div>
  </form>
</section>

<script src="/js/session-form.js"></script>
<script src="/js/password-toggle.js"></script>
