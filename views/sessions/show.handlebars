<section>
  <p><a href="/">← Toutes les sessions</a></p>

  <div class="session-header">
    <div>
      <div class="session-title-row">
        <h1>{{session.name}}</h1>
        <span class="badge badge-{{session.status}}">{{statusLabel session.status}}</span>
      </div>
      <p class="session-dates">
        {{formatDate session.startDate}} → {{formatDate session.endDate}}
        <span class="date-info">· {{session.dateInfo}}</span>
      </p>
      {{#if session.creator}}
      <p class="session-creator">Créée par {{session.creator.call}} {{session.creator.firstName}}</p>
      {{else}}
      <p class="session-creator session-creator-empty">
        Créateur non renseigné · <a href="/sessions/{{session.id}}/edit">compléter</a>
      </p>
      {{/if}}
    </div>
    <div class="session-actions">
      <details class="band-filter" id="band-filter">
        <summary class="btn-secondary btn-small">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="3 4 21 4 14 12.5 14 19 10 21 10 12.5 3 4"></polygon>
          </svg>
          Bandes affichées
        </summary>
        <div class="band-filter-menu">
          <div class="band-filter-actions">
            <button type="button" id="band-filter-all">Toutes</button>
            <button type="button" id="band-filter-none">Aucune</button>
            <button type="button" id="band-filter-hf">HF</button>
            <button type="button" id="band-filter-vhf">VHF/UHF</button>
          </div>
          {{#each bands}}
          <label class="band-filter-option">
            <input type="checkbox" value="{{this}}" checked>
            {{this}}
          </label>
          {{/each}}
        </div>
      </details>
      <a href="/sessions/{{session.id}}/edit" class="btn-secondary btn-small" id="manage-link"
        data-session-id="{{session.id}}" data-locked="{{#if session.passwordHash}}true{{else}}false{{/if}}"
        title="Modifier le nom, les dates, les opérateurs, le statut">⚙ Gérer</a>
    </div>
  </div>

  {{#if error}}
  <p class="error">{{error}}</p>
  {{/if}}

  <dialog id="password-dialog" class="password-dialog">
    <form id="password-form">
      <h2>Mot de passe requis</h2>
      <p>Cette session est protégée. Saisissez le mot de passe de gestion pour continuer.</p>
      <label>
        Mot de passe
        {{#> password-field}}
        <input type="password" id="password-input" name="password" required autocomplete="off">
        {{/password-field}}
      </label>
      <p class="error" id="password-error" hidden></p>
      <div class="form-actions">
        <button type="button" id="password-cancel" class="btn-secondary">Annuler</button>
        <button type="submit" class="btn">Valider</button>
      </div>
    </form>
  </dialog>

  <div class="band-chart-panel">
    <h2>Utilisation des bandes</h2>
    <img src="/sessions/{{session.id}}/bands.svg"
      alt="Répartition des bandes occupées par les opérateurs, de QO-100 à 160m" class="band-chart" id="band-chart">
  </div>

  <dialog id="reserve-dialog" class="reserve-dialog">
    <form method="POST" action="/sessions/{{session.id}}/reserve" id="reserve-form">
      <h2>Réserver un créneau</h2>

      <label>
        Bande
        <select id="reserve-band" name="band" required>
          {{#each bands}}
          <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Mode
        <select id="reserve-mode" name="mode" required>
          {{#each modes}}
          <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Opérateur
        <select id="reserve-operator" name="operatorCall" required>
          <option value="" selected disabled>Choisir un indicatif</option>
          {{#each session.operators}}
          <option value="{{this.call}}">{{this.call}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Fréquence (kHz)
        <input id="reserve-frequency" type="number" name="frequency" step="any" min="0"
          placeholder="ex. 14250.00 (facultatif)">
      </label>

      <div class="form-actions">
        <button type="button" id="reserve-cancel" class="btn-secondary">Annuler</button>
        <button type="submit" class="btn">Réserver</button>
      </div>
    </form>
  </dialog>

  <div class="grid-panel">
    <div class="grid-toolbar">
      <h2>État des bandes</h2>
      <div class="grid-toolbar-actions">
        {{#unless (eq session.status 'ended')}}
        <button id="reserve-open-btn" class="btn btn-small" type="button">+ Réserver</button>
        {{/unless}}
        <button id="refresh-btn" class="btn-secondary btn-small" type="button">↻ Actualiser</button>
      </div>
    </div>

    <div class="matrix-legend">
      <span class="legend-item"><span class="legend-swatch free"></span> Libre — survol pour réserver</span>
      <span class="legend-item"><span class="legend-swatch busy"></span> Occupée — survol pour libérer (QRT)</span>
    </div>

    <div class="matrix-scroll">
      <div class="bands-matrix" id="bands-matrix" data-session-id="{{session.id}}"
        data-session-ended="{{#if (eq session.status 'ended')}}true{{else}}false{{/if}}">
        <div class="matrix-head"></div>
        {{#each modes}}
        <div class="matrix-head">{{this}}</div>
        {{/each}}

        {{#each bandRows}}
        <div class="matrix-row" data-band="{{this.band}}">
          <div class="matrix-band">{{this.band}}</div>
          {{#each this.cells}}
          {{#if this.free}}
          {{#unless (eq ../../session.status 'ended')}}
          <button type="button" class="cell free row-reserve-btn" data-band="{{this.band}}" data-mode="{{this.mode}}"
            title="Réserver {{this.band}} · {{this.mode}}">
            <span class="cell-dot" aria-hidden="true">·</span>
            <span class="cell-reserve" aria-hidden="true">+ Réserver</span>
          </button>
          {{else}}
          <div class="cell free cell-disabled" data-band="{{this.band}}" data-mode="{{this.mode}}" title="Session terminée">
            <span class="cell-dot" aria-hidden="true">·</span>
          </div>
          {{/unless}}
          {{else}}
          <div class="cell busy" data-band="{{this.band}}" data-mode="{{this.mode}}">
            <div class="cell-row">
              <span class="cell-call">{{this.operator}}</span>
              <span class="cell-info-right">{{#if this.locator}}{{this.locator}}{{#if this.department}}
                ({{this.department}}){{/if}}{{else}}{{#if this.department}}({{this.department}}){{/if}}{{/if}}</span>
            </div>
            <div class="cell-row">
              <span class="cell-info-left">{{#if this.frequency}}{{this.frequency}} kHz{{/if}}</span>
              <span class="cell-info-right">depuis {{formatDateTime this.qrvSince}}</span>
            </div>
            <form method="POST" action="/sessions/{{../../session.id}}/release" class="cell-qrt"
              data-confirm="Libérer le créneau de {{this.operator}} ?&#10;&#10;{{this.band}} · {{this.mode}}&#10;{{#if this.locator}}{{this.locator}}{{#if this.department}} ({{this.department}}){{/if}}&#10;{{else}}{{#if this.department}}({{this.department}})&#10;{{/if}}{{/if}}{{#if this.frequency}}{{this.frequency}} kHz&#10;{{/if}}QRV depuis {{formatDateTime this.qrvSince}}">
              <input type="hidden" name="band" value="{{this.band}}">
              <input type="hidden" name="mode" value="{{this.mode}}">
              <button type="submit" class="btn-danger btn-small">QRT</button>
            </form>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<script src="/js/band-filter.js"></script>
<script src="/js/refresh.js"></script>
<script src="/js/session-password.js"></script>
<script src="/js/password-toggle.js"></script>
<script src="/js/session-reserve.js"></script>