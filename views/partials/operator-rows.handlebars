<div id="operator-rows">
  {{#if values.operators.length}}
  {{#each values.operators}}
  <div class="operator-row">
    <input type="text" name="operatorCall" placeholder="Indicatif (ex. F4IXH)" required value="{{this.call}}">
    <input type="text" name="operatorLocator" placeholder="Locator (ex. JN23rl)" value="{{this.locator}}">
    <input type="text" name="operatorDepartment" placeholder="Département (ex. 13)" value="{{this.department}}">
    <button type="button" class="btn-danger remove-operator">Retirer</button>
  </div>
  {{/each}}
  {{else}}
  <div class="operator-row">
    <input type="text" name="operatorCall" placeholder="Indicatif (ex. F4IXH)" required>
    <input type="text" name="operatorLocator" placeholder="Locator (ex. JN23rl)">
    <input type="text" name="operatorDepartment" placeholder="Département (ex. 13)">
    <button type="button" class="btn-danger remove-operator">Retirer</button>
  </div>
  {{/if}}
</div>