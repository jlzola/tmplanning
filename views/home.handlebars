<section class="hero">
  <h1>{{appName}}</h1>
  <p class="pitch">
    L'outil des radioamateurs pour coordonner leurs bandes en direct : chaque
    opérateur déclare la bande et le mode qu'il utilise pendant une session
    TM.
  </p>
  <div class="hero-actions">
    <a class="btn" href="/sessions/new">+ Nouvelle session</a>
    <a class="btn-secondary" href="/about">En savoir plus</a>
  </div>
</section>

<section>
  <h2>Sessions</h2>
  {{#if sessions.length}}
  <div class="session-list">
    {{#each sessions}}
    <a class="session-card status-{{this.status}}" href="/sessions/{{this.id}}">
      <div class="session-card-header">
        <h3>{{this.name}}</h3>
        <span class="badge badge-{{this.status}}">{{statusLabel this.status}}</span>
      </div>
      <p class="session-dates">
        {{formatDate this.startDate}} → {{formatDate this.endDate}}
        <span class="date-info">· {{this.dateInfo}}</span>
      </p>
      <div class="session-card-footer">
        <span>{{this.operators.length}} opérateur(s)</span>
        <span class="chip {{#if this.occupiedCount}}chip-busy{{else}}chip-free{{/if}}">
          {{this.occupiedCount}}/{{this.totalSlots}} slots occupées
        </span>
      </div>
    </a>
    {{/each}}
  </div>
  {{else}}
  <p>Aucune session pour le moment. <a href="/sessions/new">Créez la première session</a>.</p>
  {{/if}}
</section>