<section class="hero">
  {{!-- <span class="eyebrow">📡 Pour les radioamateurs</span> --}}
  <span class="eyebrow">L'outil des radioamateurs pour coordonner l'utilisation des bandes pendant une session
    TM multi-opérateurs.</span>

  <p class="pitch">
    Utilisez une session existante ou créez une nouvelle session.<br>
    Visualisez les bandes et les modes utilisés. <br>
    Reservez une bande et un mode libres.
  </p>
  <div class="hero-actions">
    <a class="btn" href="/sessions/new">+ Nouvelle session</a>
    <a class="btn-secondary" href="/about">En savoir plus</a>
  </div>
</section>

<section>
  <h2>Sessions</h2>
  {{#if sessions.length}}
  <div class="session-list">
    {{#each sessions}}
    <a class="session-card status-{{this.status}}" href="/sessions/{{this.id}}">
      <div class="session-card-watermark" aria-hidden="true"></div>
      <div class="session-card-header">
        <h3>{{this.name}}</h3>
        <span class="badge badge-{{this.status}}">{{statusLabel this.status}}</span>
      </div>
      <p class="session-dates">📅 {{formatDate this.startDate}} → {{formatDate this.endDate}}</p>
      <p class="date-info">⏳ {{this.dateInfo}}</p>
      {{#if this.creator}}
      <p class="session-creator">✍️ créé par {{this.creator.call}} {{this.creator.firstName}}</p>
      {{/if}}
      <div class="session-card-footer">
        <span>👥 {{this.operators.length}} opérateur(s)</span>
        <span class="chip {{#if this.occupiedCount}}chip-busy{{else}}chip-free{{/if}}">
          📡 {{this.occupiedCount}}/{{this.totalSlots}} occupées
        </span>
      </div>
    </a>
    {{/each}}
  </div>
  {{else}}
  <p>Aucune session pour le moment. <a href="/sessions/new">Créez la première session</a>.</p>
  {{/if}}
</section>